#include "parser.h"
#include "ast.h"

#include <cstddef>
#include <cstdlib>
#include <iostream>
#include <utility>

Parser::Parser(std::vector<Token> tokens) : tokens_(std::move(tokens)), pos_(0) {}


ProgramNode Parser::parse() {
    ProgramNode program;
    
    while (!check(TokenType::End)) {
        program.functions.push_back(function());
    }
    
    return program;
}

std::unique_ptr<FunctionNode> Parser::function() {
    const Token& name = expect(TokenType::Identifier, "function identifier");
    expect(TokenType::Colon, ":");
    Type t = expectType();
    expect(TokenType::Equals, "=>");
    expect(TokenType::RArrow, "=>");
    std::unique_ptr<StatementNode> functionStatement = statement();
    expect(TokenType::SColon, ";");
    return std::make_unique<FunctionNode>(name.value, t, std::move(functionStatement));
}

std::unique_ptr<StatementNode> Parser::statement() {
    if (check(TokenType::LCurly)) {
        return blockStatement();
    }
    if (check(TokenType::Let)) {
        return letStatement();
    }
    if (check(TokenType::Identifier)) {
        return reassignStatement();
    }
    std::cerr << "Parse Error: expected statement!\n";
    exit(EXIT_FAILURE);
}

std::unique_ptr<LetStatementNode> Parser::letStatement() {
    expect(TokenType::Let, "let");
    const Token& name = expect(TokenType::Identifier, "identifier");
    expect(TokenType::Colon, ":");
    Type t = expectType();
    expect(TokenType::Equals, "=");
    std::unique_ptr<ExpressionNode> init = expression();
    expect(TokenType::SColon, ";");
    return std::make_unique<LetStatementNode>(name.value, t, std::move(init));
}

std::unique_ptr<BlockStatementNode> Parser::blockStatement() {
    expect(TokenType::LCurly, "{");
    std::vector<std::unique_ptr<StatementNode>> statements;
    while (!check(TokenType::RCurly) && !check(TokenType::End)) {
        statements.push_back(statement());
    }
    expect(TokenType::RCurly, "}");
    return std::make_unique<BlockStatementNode>(std::move(statements));
}

std::unique_ptr<ExpressionNode> Parser::expression() {
    Token temp;
    Token& tok = temp;
    bool isIdent = false;
    if (check(TokenType::Number)) {
        tok = expect(TokenType::Number, "Number or identifier");
    } else if (check(TokenType::Identifier)) {
        tok = expect(TokenType::Identifier, "Number or identifier");
        isIdent = true;
    } else {
        std::cerr << "Parse Error: expected number or identifier!\n";
        exit(EXIT_FAILURE);
    }
    if (check(TokenType::Plus) || check(TokenType::Minus)) {
        return binaryExpression(std::make_unique<TermExpressionNode>(tok.value, isIdent));
    }
    return std::make_unique<TermExpressionNode>(tok.value, isIdent);
}

std::unique_ptr<BinaryExpressionNode> Parser::binaryExpression(std::unique_ptr<ExpressionNode> l) {
    Token temp;
    Token& tok = temp;
    char op = ' ';
    if (check(TokenType::Plus)) {
        expect(TokenType::Plus, "+/-");
        op = '+';
    } else if (check(TokenType::Minus)) {
        expect(TokenType::Minus, "+/-");
        op = '-';
    } else {
        std::cerr << "Parse Error: expected +/-\n";
        exit(EXIT_FAILURE);
    }
    return std::make_unique<BinaryExpressionNode>(std::move(l), op, expression());
}

const Token& Parser::peek() const {
    return tokens_.at(pos_);
}

const Token& Parser::advance() {
    return tokens_.at(pos_++);
}

bool Parser::check(TokenType t)  const {
    return peek().type == t;
}

bool Parser::match(TokenType t) {
    if (check(t)) {
        this->pos_++;
        return true;
    }
    return false;
}

const Token& Parser::expect(TokenType type, const char* what) {
    if (check(type)) return advance();
    std::cout << "Parse Error: expected " << what << std::endl;
    exit(EXIT_FAILURE);
}

Type Parser::expectType() {
    if (match(TokenType::i32)) return Type::i32;
    std::cerr << "Parse Error: Expected type!\n";
    exit(EXIT_FAILURE);
}
