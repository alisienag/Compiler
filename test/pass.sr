// ===========================================================================
// pass.sr -- EVERYTHING HERE MUST COMPILE WITH ZERO ERRORS.
// If any line below reports an error, your checker is too strict.
// ===========================================================================

// --- both function body forms
fn add(a: i32, b: i32): i32 => a + b;

fn sub(a: i32, b: i32): i32 => {
    ret a - b;
}

// --- void function, bare ret
fn nothing(): void => {
    ret;
}

// --- void function with no ret at all
fn alsoNothing(): void => {
    let unused: i32 = 1;
}

// --- mutable parameter
fn accumulate(mut n: i32): i32 => {
    n = n + 1;
    ret n;
}

// --- recursion
fn fib(n: i32): i32 => {
    if n < 2 { ret n; }
    ret fib(n - 1) + fib(n - 2);
}

// --- mutual recursion: forward reference to a function declared LATER
fn ping(n: i32): i32 => {
    if n <= 0 { ret 0; }
    ret pong(n - 1);
}

fn pong(n: i32): i32 => {
    if n <= 0 { ret 1; }
    ret ping(n - 1);
}

// --- shadowing an outer scope is legal
fn shadowBlock(x: i32): i32 => {
    let y: i32 = x;
    {
        let y: i32 = 99;
        let z: i32 = y;
    }
    ret y;
}

// --- a local may shadow a parameter
fn shadowParam(x: i32): i32 => {
    let x: i32 = 5;
    ret x;
}

// --- sibling blocks may reuse a name
fn siblingBlocks(): i32 => {
    { let a: i32 = 1; }
    { let a: i32 = 2; }
    ret 0;
}

// --- type inference: no annotation
fn inferred(): i32 => {
    let a = 10;
    let b = a + 5;
    ret b;
}

// --- if / else if / else chain
fn classify(n: i32): i32 => {
    if n < 0 {
        ret 0 - 1;
    } else if n == 0 {
        ret 0;
    } else {
        ret 1;
    }
}

// --- while, break, continue (break inside an if inside a loop)
fn loops(): i32 => {
    mut i: i32 = 0;
    mut total: i32 = 0;
    while i < 10 {
        i = i + 1;
        if i == 3 { continue; }
        if i == 8 { break; }
        total = total + i;
    }
    ret total;
}

// --- nested loops: break belongs to the inner one
fn nestedLoops(): i32 => {
    mut i: i32 = 0;
    while i < 3 {
        mut j: i32 = 0;
        while j < 3 {
            j = j + 1;
            if j == 2 { break; }
        }
        i = i + 1;
    }
    ret i;
}

// --- logical operators and negation
fn logic(a: bool, b: bool): bool => {
    ret a && !b || b;
}

// --- comparison producing bool
fn compare(a: i32, b: i32): bool => a <= b;

// --- casts, including a chain
fn casts(n: i32): i64 => {
    let small = n as u8;
    let wide  = small as i32 as i64;
    ret wide;
}

// --- arrays via string literal, read and write through a mut binding
fn arrays(): u8 => {
    mut s: [u8] = "hello";
    let first = s[0];
    s[1] = first;
    ret s[1];
}

// --- immutable array: READING through it is fine, only writing is not
fn readOnlyArray(): u8 => {
    let s: [u8] = "world";
    ret s[0];
}

// --- nested array type
fn nestedType(grid: [[i32]]): i32 => {
    ret grid[0][0];
}

// --- calls with the right arity and types
fn callsOk(): i32 => {
    let a = add(1, 2);
    let b = sub(a, 1);
    nothing();
    ret b;
}

// --- a local may shadow a function name
fn shadowFn(): i32 => {
    let add: i32 = 7;
    ret add;
}

// --- entry point
fn start(): i32 => {
    ret fib(10);
}

