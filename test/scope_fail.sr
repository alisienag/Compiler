// ===========================================================================
// scope_fail.sr -- 15 SCOPE ERRORS, one per marked line.
// Everything else is type-clean, so any type errors reported here are bugs.
// Expected count: 15
// ===========================================================================

fn helper(a: i32, b: i32): i32 => a + b;

// [1] duplicate parameter name
fn dupParam(x: i32, x: i32): i32 => x;

// [2] duplicate function name (helper is already defined above)
fn helper(n: i32): i32 => n;

fn undeclaredUse(): i32 => {
    // [3] identifier never declared
    ret ghost;
}

fn undeclaredCall(): i32 => {
    // [4] function never declared
    ret noSuchFunction(1);
}

fn duplicateLocal(): i32 => {
    let a: i32 = 1;
    // [5] redeclared in the SAME scope
    let a: i32 = 2;
    ret a;
}

fn selfReference(): i32 => {
    // [6] initialiser refers to the variable being declared
    let n: i32 = n;
    ret n;
}

fn selfReferenceInferred(): i32 => {
    // [7] same, with no annotation
    let m = m + 1;
    ret m;
}

fn escapedScope(): i32 => {
    {
        let inner: i32 = 1;
    }
    // [8] inner is out of scope here
    ret inner;
}

fn assignImmutable(): i32 => {
    let a: i32 = 1;
    // [9] assigning to a let binding
    a = 2;
    ret a;
}

fn assignImmutableParam(p: i32): i32 => {
    // [10] parameters are immutable unless declared mut
    p = 5;
    ret p;
}

fn assignThroughImmutable(): u8 => {
    let s: [u8] = "abc";
    // [11] writing through an immutable binding
    s[0] = 65;
    ret s[0];
}

fn assignToCall(): i32 => {
    // [12] left side is not an lvalue
    helper(1, 2) = 3;
    ret 0;
}

fn breakOutside(): i32 => {
    // [13] no enclosing loop
    break;
    ret 0;
}

fn continueOutsideInIf(n: i32): i32 => {
    if n > 0 {
        // [14] an if is not a loop
        continue;
    }
    ret 0;
}

fn breakAfterLoop(): i32 => {
    mut i: i32 = 0;
    while i < 3 {
        i = i + 1;
    }
    // [15] the loop has ended; loopDepth_ must be back to 0
    break;
    ret i;
}

