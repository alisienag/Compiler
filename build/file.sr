add(i: i32, j: i32): i32 => ret i + j;

main(): i32 => {
    let message: string = "hey\n";
    print(message, 4);   
    {
        let message: string = "hello\n";
        print(message, 6);
    }
    {
        print(message, 4);
        message = "hi\n";
        print(message, 3);
    }
    print(message, 4);
    ret add(1, 2);
}
